# Copie este arquivo para ".env" e preencha os valores.

# Supabase: Project Settings > Database > Connection string > "Session pooler".
# (A conexão direta "db.xxx.supabase.co" só funciona com IPv6 e falha na maioria das redes.)
# Se a senha tiver caracteres especiais (@ : / # ? etc.), codifique-os (ex.: @ vira %40).
DATABASE_URL=postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-1-us-west-2.pooler.supabase.com:5432/postgres?sslmode=require

# Chave para assinar a sessão de login. Gere uma com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-aleatoria

# Em produção (HTTPS) use 1 para o cookie de login só trafegar por HTTPS.
SESSION_COOKIE_SECURE=0
